{
  "routes": [
    { "src": "/sw.js", "headers": { "Cache-Control": "public, max-age=0, must-revalidate", "Service-Worker-Allowed": "/" }, "continue": true },
    { "src": "/manifest.json", "headers": { "Cache-Control": "public, max-age=0, must-revalidate", "Content-Type": "application/manifest+json" }, "continue": true },
    { "src": "/poty", "dest": "/index-poty.html" },
    { "src": "/dashboard", "dest": "/dashboard.html" },
    { "src": "/", "dest": "/index.html" }
  ]
}
